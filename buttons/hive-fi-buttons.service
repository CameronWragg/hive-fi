[Unit]
Description=hive-fi Pirate Audio buttons
Documentation=https://github.com/CameronWragg/hive-fi

[Service]
Type=simple
User=__HIVE_FI_USER__
Group=__HIVE_FI_GROUP__
SupplementaryGroups=gpio spi
ExecStart=__HIVE_FI_PYTHON__ __HIVE_FI_ROOT__/buttons/hive-fi-buttons.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
